# terraform.tfvars の見本（core-002・core-018）。`cp terraform.tfvars.example terraform.tfvars` で写して値を入れる。
# terraform.tfvars はコミットしない（infra/.gitignore）。秘密の値はここにも書かない（DB のパスワードは Terraform が作る）。
# 値の意味は variables.tf。

project_id         = "kanaeru-prod-xxxx"
billing_account_id = "000000-000000-000000"
github_repository  = "owner/kanaeru-apps"
# 上のリポジトリと持ち主の数字の ID（変わらない値。README の 4）：gh api repos/<owner>/<repo> --jq '.id, .owner.id'
github_repository_id       = "123456789"
github_repository_owner_id = "12345678"

# 既定のままでよいもの
# region          = "asia-northeast1"
# budget_amount   = 2000
# budget_currency = "JPY"

# 本番（main のマージで出る）。LINE の値はどれも秘密ではない（LINE Developers のコンソールで見る。README の 4）
production = {
  line_channel_ids       = "1234567890"
  organizer_line_user_id = "U00000000000000000000000000000000"
  open_chat_url          = "https://line.me/ti/g2/xxxxxxxx"

  # 既定のままでよいもの
  # web_url             = ""          # 空なら https://kanaeru-<プロジェクト番号>.asia-northeast1.run.app。独自ドメインならその URL
  # app_name            = "kanaeru"
  # db_password_version = 1

  # Threads（入にする手順は README の 9）・予約（README の 10）。既定は切
  # threads_enabled     = false
  # booking_enabled     = false
  # booking_notify_mode = "off"   # off・allowlist・on
}

# ステージング（develop のマージと、main のマージ〈本番の前〉で出る。本番と同じ Cloud SQL のサーバーの中の別の DB。README の 11）。作らないなら null
staging = {
  line_channel_ids       = "2345678901" # ステージング用の LINE ミニアプリのチャネル
  organizer_line_user_id = "U00000000000000000000000000000000"
  open_chat_url          = "https://line.me/ti/g2/xxxxxxxx"
  app_name               = "kanaeru（ステージング）"

  # web_url             = ""          # 空なら https://kanaeru-stg-<プロジェクト番号>.asia-northeast1.run.app
  # threads_enabled     = false       # 入にしても、つなぐのは試し用の Threads のアカウントだけ
  # booking_enabled     = false
  # booking_notify_mode = "off"       # off・allowlist だけ（on は止まる）
}
