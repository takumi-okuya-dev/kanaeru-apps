# 手元の設定の見本。`cp .env.example .env` で写して使う。.env はコミットしない（秘密の値を入れるため）。
# API・画面の組み立て・docker compose・E2E が、リポジトリのルートの .env を読む。
# 値の意味と確かめは apps/api/src/kernel/config.ts。

# 環境の名前（local／test／staging／production）。危ない設定の組み合わせを止めるためだけに見る
APP_ENV=local
# 画面に出すアプリの名前（仮の名前。資源の名前には焼き込まない）
APP_NAME=kanaeru（仮）

# 手元の口の番号（作業場所ごとにずらす。docs/rules/parallel-development.md 1）
API_PORT=8787
# API が受け付ける宛先。手元は 127.0.0.1（ほかの機械から届かない）。容器で動かす staging・production は 0.0.0.0 にする
API_HOST=127.0.0.1
WEB_PORT=5173
# 画面の源。API は、この源からの書きこみだけを受け付ける（ほかの源の Origin は 403）。
# 手元では空のままでよい（WEB_PORT から http://localhost:<番号> を作る）。staging・production は https:// で必須
WEB_URL=

# DB の接続先。作業場所ごとに DB の名前（最後の「app」）を変える。なければ db:migrate が作る
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# DB の時間の上限（ミリ秒）。つなぐまで・1つの命令。DB が答えないとき、要求が待ち続けないように
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
# 1台（API の1つのプロセス）が持つ DB の接続の数の上限（1以上の整数。既定は10）。
# 本番は infra/environments.tf で、台数の上限 × この値が DB の接続の上限を超えないように決める
DATABASE_POOL_MAX=10
# docker compose の Postgres の口の番号（作業場所で共通にする）
POSTGRES_PORT=5432
# docker compose の名前（作業場所で共通にし、Postgres の容器を1つだけ使う。プロダクトの名前に替えてよい）
COMPOSE_PROJECT_NAME=kanaeru-local

# 見本のデータを入れる手順（pnpm db:seed）を許すか。staging・production で true だと起動しない
SAMPLE_DATA_ENABLED=true
# 試験用のログイン（POST /api/v1/auth/test-login・画面の /dev/login）を使えるか。手元の http では本物の LINE ログインが
# 動かないので、手元は true。staging・production で true だと起動しない
TEST_LOGIN_ENABLED=true
# API の窓口の文書（GET /api/openapi.json）を出すか。production で true だと起動しない
OPENAPI_DOC_ENABLED=true

# 領域の機能の印。入にする「<領域>.<名前>」をカンマで並べる（例：event.export）。既定は空（どれも切）。
# 大きな機能を設定の1行で止める・入れるため（docs/rules/coding.md 2）。形が合わないと起動しない
DOMAIN_FEATURES=

# LINE のミニアプリのチャネル ID（数字）。LINE の ID トークンを確かめるときの client_id。カンマで並べられる。
# 手元・テストでは空でよい（試験用のログインを使う）。staging・production で空だと起動しない
LINE_CHANNEL_IDS=
# 主催者の LINE のユーザー ID（U と16進の32文字。秘密ではない）。staging・production で空だと起動しない
ORGANIZER_LINE_USER_ID=
# コミュニティのオープンチャットの URL（https。任意）。空ならチェックインのあとの案内を出さない
OPEN_CHAT_URL=
# 組み立てた画面（apps/web の vite build の出力）のフォルダ。あれば API が画面のファイルを返す（1つのコンテナ）。
# 手元の pnpm dev は Vite が画面を返すので空でよい。staging・production で空だと起動しない
WEB_DIST_DIR=
# 画面に埋める LIFF ID（組み立てのときだけ読む。公開してよい値）。手元は空のまま（LINE につながない仮の形で動く）
VITE_LIFF_ID=

# Threads の運用アプリ（threads-002）。手元で試すときは下の3つを入れる（見せるかはアプリの台帳で決める。はじめは運営者だけ）。
# 外のサービスのトークンを包む鍵の束（{"1":"<32バイトの base64>"}。秘密）と今の鍵の版。作り方：
#   printf '{"1":"%s"}' "$(openssl rand -base64 32)"
# 空なら Threads への接続は「準備ができていません」と断る
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_KEY_VERSION=
# 定期の仕事（Cloud Scheduler）が API を呼ぶときの合言葉（32文字以上。秘密）。空なら定期の仕事の窓口は 404
JOB_TRIGGER_SECRET=
# Threads の API の宛先。空なら https://graph.threads.net。手元で偽の Threads を使うときは
# pnpm --filter api exec tsx src/modules/threads/fake-threads-serve.ts を立ち上げて http://127.0.0.1:9790 にする
THREADS_API_BASE_URL=
# アプリの Meta のアプリ（threads-010。OAuth の接続と Meta の Webhook）。使うときは DOMAIN_FEATURES に threads.oauth も足す。
# ID は数字、秘密の値（App Secret。秘密）は Meta の開発者の画面から。両方入れるか、両方空にする（空なら OAuth と Webhook は使えない）。
# Meta に登録するリダイレクトの URL：<WEB_URL>/api/v1/threads/oauth/callback
# Webhook：<WEB_URL>/api/v1/threads/webhooks/uninstall・<WEB_URL>/api/v1/threads/webhooks/data-deletion
THREADS_APP_ID=
THREADS_APP_SECRET=

# 予約の知らせ（booking-002。LINE 公式アカウントとメール。AD-24）。送り方は off（既定。何も送らない）・allowlist（許可リストの宛先だけ）・on。
# APP_ENV が local・test のときは、どの値でも本物に送らず、偽の送り手が覚えるだけ（手元で試すときは on にしてよい）。
# 公式アカウントの設定を保存するには、上の TOKEN_ENCRYPTION_KEYS・TOKEN_ENCRYPTION_KEY_VERSION も要る
NOTIFY_MODE=off
# 許可リスト（秘密）：公式アカウントから見える LINE のユーザー ID（U と16進の32文字）とメールアドレスをカンマで並べる
NOTIFY_ALLOWLIST=

# 回数の制限（IP ごと）。RATE_LIMIT_WINDOW_SECONDS 秒の間に、/api/v1 の書く操作を RATE_LIMIT_MAX 回まで。
# staging・production で false だと起動しない
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100
# API の前に置いた中継（ロードバランサーなど）の数。0 なら接続の相手を、1以上なら X-Forwarded-For の右から数えた値を利用者の IP とする
TRUSTED_PROXY_HOPS=0

# ログの細かさ（fatal／error／warn／info／debug／trace／silent）
LOG_LEVEL=info
# true でログを人が読みやすい形にする（手元だけ。ふだんは1行1つの JSON）
LOG_PRETTY=true
