{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/create-database.ts && drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "openapi": "tsx --env-file-if-exists=../../.env scripts/openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/server": "^2.4.0",
    "@workspace/contracts": "workspace:*",
    "@workspace/csv": "workspace:*",
    "@workspace/secret-box": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "5.12.0",
    "hono": "^4.13.22",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
